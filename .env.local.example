# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Resend
RESEND_API_KEY=re_your_api_key

# News Publishing
NEWS_PASSCODE=your_news_passcode

# Supabase S3 Storage (for news image uploads)
SUPABASE_S3_ENDPOINT=https://YOUR_PROJECT.storage.supabase.co/storage/v1/s3
SUPABASE_S3_ACCESS_KEY_ID=your_access_key_id
SUPABASE_S3_SECRET_ACCESS_KEY=your_secret_access_key

# Checkout provider for new purchases: "stripe" or "dodo" (see docs/PAYMENTS.md)
NEXT_PUBLIC_CHECKOUT_PROVIDER=dodo

# Stripe
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_PRICE_QUARTERLY=price_your_quarterly_price
STRIPE_PRICE_ANNUAL=price_your_annual_price
STRIPE_AUTOMATIC_TAX=false

# Dodo Payments (kept for existing subscribers)
NEXT_PUBLIC_DODO_MONTHLY_ID=prod_your_quarterly_product_id
NEXT_PUBLIC_DODO_ANNUAL_ID=prod_your_annual_product_id
NEXT_PUBLIC_DODO_MODE=test
NEXT_PUBLIC_REDIRECT_URL=http://localhost:3000/thanks

# Mobile subscription (Dodo Payments)
DODO_PAYMENTS_API_KEY=dodo_test_your_key
DODO_MOBILE_PRODUCT_ID=prod_your_mobile_subscription_product_id
DODO_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# NBA scores (used by /api/basketball) — free key at https://app.balldontlie.io
BALLDONTLIE_API_KEY=your_balldontlie_key

# Admin dashboard — comma-separated emails allowed into /admin (checked server-side)
ADMIN_EMAILS=you@tryscoredeck.pro

# Sports data providers — one per sport (see docs/DATA_PROVIDERS.md). Default: legacy
DATA_PROVIDER_SOCCER=legacy
DATA_PROVIDER_CRICKET=legacy
DATA_PROVIDER_BASKETBALL=legacy
DATA_PROVIDER_F1=legacy

# Google AdSense slot used when no direct sponsor fills an ad slot (see docs/ADS.md).
# Empty = show ScoreDeck house ads instead. Publisher ID is set in the layout + public/ads.txt.
NEXT_PUBLIC_ADSENSE_SLOT_INLINE=
