# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Resend
RESEND_API_KEY=re_your_api_key

# News Publishing
NEWS_PASSCODE=your_news_passcode

# Supabase S3 Storage (for news image uploads)
SUPABASE_S3_ENDPOINT=https://YOUR_PROJECT.storage.supabase.co/storage/v1/s3
SUPABASE_S3_ACCESS_KEY_ID=your_access_key_id
SUPABASE_S3_SECRET_ACCESS_KEY=your_secret_access_key

# Dodo Payments
NEXT_PUBLIC_DODO_PRODUCT_ID=prod_your_product_id
NEXT_PUBLIC_DODO_MODE=test
NEXT_PUBLIC_REDIRECT_URL=http://localhost:3000/thanks

# Mobile subscription (Dodo Payments)
DODO_PAYMENTS_API_KEY=dodo_test_your_key
DODO_MOBILE_PRODUCT_ID=prod_your_mobile_subscription_product_id
DODO_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# NBA scores (used by /api/basketball) — free key at https://app.balldontlie.io
# (currently hardcoded in api/basketball/route.ts — move to env before commercial launch)
BALLDONTLIE_API_KEY=your_balldontlie_key
